# ─────────────────────────────────────────────────────────
# COMMON — same for dev and prod
# ─────────────────────────────────────────────────────────

# Project codename — used as docker compose project name and container prefix
PROJECT_CODENAME=flashcardacademy

# Tool versions — single source of truth for containers and host
GO_VERSION=1.26.2
BUN_VERSION=1.3.12
CADDY_VERSION=2.11.2
POSTGRES_VERSION=18.3
AIR_VERSION=1.65.0

# Ports
API_PORT=8080

# ─────────────────────────────────────────────────────────
# ENVIRONMENT-SPECIFIC — adapt for your env
# ─────────────────────────────────────────────────────────

# Active environment (dev or prod) — selects compose.<APP_ENV>.yaml
APP_ENV=dev

# Host binding for dev ports (loopback by default — set to 0.0.0.0 to expose on LAN/Tailscale)
DEV_HOST=127.0.0.1

# Application domain
# DEV: flashcardacademy.localhost (Caddy auto-issues an internal CA cert)
# PROD: your real domain, e.g. flashcardacademy.io
APP_DOMAIN=flashcardacademy.localhost

# Postgres credentials
# DEV: defaults below are fine.
# PROD: use Docker secrets (see TODO in docker/compose.yaml).
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Test database — separate DB on the same Postgres instance, used by the Go
# test suite (created on first run, migrated, then TRUNCATE'd between tests).
TEST_POSTGRES_DB=flashcardacademy_test

# Let's Encrypt ACME account email — used in prod for cert registration
# Ignored in dev (internal CA used instead)
ACME_EMAIL=TODO_YOUR_EMAIL@example.com

# ─────────────────────────────────────────────────────────
# AUTH — magic link + sessions
# ─────────────────────────────────────────────────────────

# Public base URL used to build magic-link URLs sent by email.
# DEV: https://flashcardacademy.localhost
# PROD: https://flashcardacademy.io
APP_BASE_URL=https://flashcardacademy.localhost

# Email provider: "console" (logs link to stdout — for dev) or "resend" (HTTP → Resend API)
EMAIL_PROVIDER=console

# Resend credentials (only required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Sender shown in the user's inbox. Resend recommends "Name <email>" format
# for better deliverability and inbox display.
EMAIL_FROM=Flashcard Academy <hello@flashcardacademy.io>

# Session & magic-link TTLs
# 8760 = 1 year. Long sessions are intentional for a mobile family app
# (Duolingo/Spotify-style). Sessions are DB-backed so we can revoke anytime.
SESSION_TTL_HOURS=8760
MAGIC_LINK_TTL_MINUTES=15

# ─────────────────────────────────────────────────────────
# AI — flashcard generation
# ─────────────────────────────────────────────────────────

# Anthropic API key. Required to boot, in dev too: unlike EMAIL_PROVIDER,
# card generation has no console-style stand-in, and dev calls the real API
# on purpose so we see real generation quality. https://console.anthropic.com/
ANTHROPIC_API_KEY=
