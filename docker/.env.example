# Project
PROJECT_CODENAME=flashcardacademy

# Versions
GO_VERSION=1.26.2
BUN_VERSION=1.3.12
CADDY_VERSION=2.11.2
POSTGRES_VERSION=18.3
AIR_VERSION=1.65.0

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ports
DEV_HOST=127.0.0.1
API_PORT=8080

# Domain — dev uses .localhost (Caddy auto-generates a local TLS cert).
# In prod, set to your real domain (e.g. flashcardacademy.io).
APP_DOMAIN=flashcardacademy.localhost

# Let's Encrypt ACME account email — used in prod for certificate
# registration and expiration alerts. Ignored in dev.
ACME_EMAIL=TODO_YOUR_EMAIL@example.com
