{
	admin off
	log default {
		format console
	}
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# No explicit tls directive — Caddy auto-selects:
	#   - internal CA for .localhost (dev)
	#   - Let's Encrypt for public hostnames (prod, using the global email)

	encode zstd gzip

	# Security headers applied to every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		-Server
	}

	# The magic-link verify URL carries a single-use token in its query
	# string. Skip access logging here so the token cannot be replayed by
	# anyone with read access to the log sink within its 15-min TTL. The
	# Go API still logs the resulting business event ("session created")
	# with user_id but no token.
	log_skip /api/auth/verify

	handle /api/* {
		reverse_proxy api:8080 {
			# Drop any client-supplied X-Forwarded-For (otherwise the
			# left-most value is attacker-controlled and our logging /
			# future rate-limiter trusts the wrong IP). We attest the
			# real client IP ourselves via X-Real-IP.
			header_up -X-Forwarded-For
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		import /etc/caddy/frontend.caddy
	}
}
