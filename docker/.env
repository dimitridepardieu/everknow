# Project
PROJECT_CODENAME=flashcardacademy

# Versions
GO_VERSION=1.26.2
BUN_VERSION=1.3.12
CADDY_VERSION=2.11.2
POSTGRES_VERSION=18.3
AIR_VERSION=1.65.0

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ports
API_PORT=8080
DEV_HOST=127.0.0.1

# Site (dev default, overridden in compose.prod.yaml)
SITE_ADDRESS=flashcardacademy.localhost

# Let's Encrypt ACME account email — used in prod for Let's Encrypt registration
# and expiration alerts. Ignored in dev (Caddy auto-uses internal CA for .localhost).
# Replace with your personal email before first prod deploy.
ACME_EMAIL=TODO_YOUR_EMAIL@example.com
