# syntax=docker/dockerfile:1

ARG GO_VERSION

# --- Base stage: Go toolchain + dependencies ---
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-trixie AS base
WORKDIR /app
COPY --link go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod/ \
    go mod download
COPY --link . .

# --- Dev stage: adds hot-reload with air ---
FROM base AS dev
ARG AIR_VERSION
RUN go install github.com/air-verse/air@v${AIR_VERSION}
CMD ["air"]

# --- Build stage: compile the binary ---
FROM base AS build
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod/ \
    CGO_ENABLED=0 GOARCH=$TARGETARCH go build -ldflags="-s -w" -o /server .
RUN adduser --disabled-password --no-create-home --uid 10001 appuser

# --- Prod stage: minimal image with just the binary ---
FROM scratch AS prod
COPY --from=build /etc/passwd /etc/passwd
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=build /server /server
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD ["/server", "healthcheck"]
ENTRYPOINT ["/server"]
